# Copy to .env in this directory before running Docker Compose.
# Local development example; keep real credentials in the ignored .env file.
# Compose overrides DATABASE_URL with its configured database credentials.
# For runs outside Compose, set the actual host, published port and password.
PORT=4000
DATABASE_URL="postgresql://postgres:local-development-password@postgres:5432/monolith_db?schema=public"
JWT_SECRET=your_jwt_secret
GROQ_API_KEY=your_groq_api_key_here
