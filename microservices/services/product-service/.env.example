# Local development example; keep real credentials in the ignored .env file.
PORT=3002
MONGO_URI=mongodb://root:examplepassword@mongo:27017/microservices_products?authSource=admin
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
